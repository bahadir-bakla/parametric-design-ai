<UserControl x:Class="RoofAI.UI.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="350">
    <UserControl.Resources>
        <!-- Stil kaynakları -->
        <SolidColorBrush x:Key="PanelBackground" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="UserMessageBackground" Color="#DCF8C6"/>
        <SolidColorBrush x:Key="AIMessageBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SystemMessageBackground" Color="#FFF3CD"/>
        <SolidColorBrush x:Key="ErrorMessageBackground" Color="#F8D7DA"/>
        <SolidColorBrush x:Key="PrimaryButtonColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DDDDDD"/>
        
        <!-- Mesaj balonu stili -->
        <Style x:Key="MessageBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Buton stili -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="{StaticResource PrimaryButtonColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource PanelBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
            <RowDefinition Height="*"/>    <!-- Messages -->
            <RowDefinition Height="Auto"/> <!-- Input -->
            <RowDefinition Height="Auto"/> <!-- Quick Actions -->
        </Grid.RowDefinitions>
        
        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryButtonColor}" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🏠" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="RoofAI Asistan" 
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SettingsButton" 
                            Content="⚙️" 
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="16"
                            Padding="5"
                            Click="SettingsButton_Click"/>
                    <Button x:Name="ClearButton" 
                            Content="🗑️" 
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="16"
                            Padding="5"
                            Click="ClearButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- STATUS BAR -->
        <Border Grid.Row="1" Background="#E3F2FD" Padding="10,5" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#4CAF50" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="Ollama bağlı" FontSize="11" Foreground="#1565C0"/>
                <TextBlock x:Name="ContextIndicator" Text="" FontSize="11" Foreground="#666" Margin="15,0,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- MESSAGES AREA -->
        <ScrollViewer Grid.Row="2" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto" Margin="10">
            <StackPanel x:Name="MessagesPanel" Orientation="Vertical">
                <!-- Hoşgeldin mesajı -->
                <Border Style="{StaticResource MessageBorderStyle}" 
                        Background="{StaticResource SystemMessageBackground}"
                        HorizontalAlignment="Center"
                        MaxWidth="300">
                    <TextBlock Text="Merhaba! Ben RoofAI. Çatı, cephe veya mobilya tasarımında size yardımcı olabilirim. Örneğin: '20x15 beşik çatı yap'" 
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#856404"/>
                </Border>
                
                <!-- Mesajlar buraya dinamik eklenecek -->
            </StackPanel>
        </ScrollViewer>
        
        <!-- TYPING INDICATOR -->
        <Border Grid.Row="2" x:Name="TypingIndicator" 
                Background="White" 
                CornerRadius="15"
                Padding="15,8"
                Margin="15,0,15,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Visibility="Collapsed"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🤖 Yazıyor" Foreground="#666" FontSize="11"/>
                <TextBlock x:Name="TypingDots" Text="..." Foreground="#666" FontSize="11" Margin="3,0,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- INPUT AREA -->
        <Border Grid.Row="3" Background="White" Padding="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="InputTextBox" 
                         Grid.Column="0"
                         Height="45"
                         Padding="10,8"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         BorderBrush="{StaticResource BorderColor}"
                         BorderThickness="1"
                         Background="#FAFAFA"
                         KeyDown="InputTextBox_KeyDown"
                         TextChanged="InputTextBox_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                
                <Button x:Name="SendButton" 
                        Grid.Column="1"
                        Content="📤"
                        FontSize="18"
                        Width="45"
                        Height="45"
                        Margin="8,0,0,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SendButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
        
        <!-- QUICK ACTIONS -->
        <Border Grid.Row="4" Background="#FAFAFA" Padding="10" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button Content="20x15 Çatı" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Click="QuickAction_Click"
                            Tag="20x15 beşik çatı yap"/>
                    <Button Content="Cephe Oluştur" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Click="QuickAction_Click"
                            Tag="10 metre cephe yap grid pattern"/>
                    <Button Content="Yardım" 
                            Background="#6C757D"
                            Style="{StaticResource ActionButtonStyle}" 
                            Click="QuickAction_Click"
                            Tag="yardım"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
